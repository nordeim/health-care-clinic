// Green Grove Family Clinic — data model.
// Two write paths:
//   1. The landing page's "Request an appointment" form:
//      POST /api/appointments -> validation -> Appointment row.
//   2. Staff sign-in at /login: POST /api/auth/login -> scrypt verify ->
//      session cookie. The single AdminUser row is seeded by db:seed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Appointment {
  id            String   @id @default(cuid())
  fullName      String
  phone         String
  email         String?
  specialty     String
  preferredDate String?
  // Workflow state (session-16 G1): "new" -> "confirmed" -> "completed" as
  // rendered by the dashboard badges; the value space lives in
  // src/lib/content.ts (appointmentStatuses) and the API allowlist is
  // DERIVED from it (src/lib/validation.ts APPOINTMENT_STATUSES). SQLite
  // has no native enums — an allowlisted String column is the doctrine.
  status        String   @default("new")
  // Simple abuse signal: createdAt is exposed only to the API layer.
  createdAt     DateTime @default(now())
  // Stamped on every status transition (Prisma @updatedAt) — the audit
  // trail for PATCH /api/appointments/[id]. Defaults to now() so
  // `prisma db push` is data-preserving for pre-existing rows.
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([createdAt])
  @@map("appointments")
}

// Staff account for the appointment dashboard. The password is NEVER stored
// in plain text — hashPassword() stores `scrypt$salt$hash`. Seeded (or
// updated) by `bun run db:seed` from ADMIN_EMAIL / ADMIN_PASSWORD in .env.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("admin_users")
}
