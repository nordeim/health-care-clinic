{
  "name": "health-care-clinic",
  "version": "1.0.0",
  "description": "Green Grove Family Clinic — production-grade Next.js 16 clone of the Base44 health-care-clinic landing experience (React 19 + Tailwind CSS v4 + Prisma/SQLite)",
  "private": true,
  "scripts": {
    "dev": "env -u DATABASE_URL next dev -p 3000 2>&1 | tee dev.log",
    "build": "env -u DATABASE_URL next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "db:push": "env -u DATABASE_URL prisma db push --accept-data-loss",
    "db:generate": "env -u DATABASE_URL prisma generate",
    "db:migrate": "env -u DATABASE_URL prisma migrate dev",
    "db:reset": "env -u DATABASE_URL prisma migrate reset",
    "db:seed": "env -u DATABASE_URL bun scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "prisma": "^6.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "prisma",
    "unrs-resolver"
  ]
}