# Green Grove Family Clinic — environment configuration
# Copy to .env and adjust:
#   cp .env.example .env && bun run db:push && bun run db:seed
# Production guidance: docs/DEPLOYMENT.md

# ---- Database -------------------------------------------------------------
# SQLite by default (zero-config local dev). The `db/` folder lives at the
# repo root and is git-ignored. A RELATIVE `file:` URL resolves against
# prisma/schema.prisma — exactly like the Prisma CLI — so `file:../db/custom.db`
# points at <repo>/db/custom.db for the CLI (db:push / db:seed), for
# `next dev`, `next build` and the running dev server alike, regardless of
# the process working directory. (src/lib/db-path.ts implements this
# contract; tests/db-path.test.ts pins it.)
#
# NOTE — ambient-variable guard: the dev / build / db:* npm scripts strip any
# ambient DATABASE_URL (`env -u`) so a stray exported shell variable can never
# shadow this file. The production `start` script deliberately KEEPS ambient
# env: set an ABSOLUTE file: URL (or a PostgreSQL connection string) there —
# see docs/DEPLOYMENT.md §4.
DATABASE_URL="file:../db/custom.db"

# ---- Site -----------------------------------------------------------------
# Canonical public origin — used for metadata tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Staff authentication (login + dashboard) ------------------------------
# AUTH_SECRET signs the staff session cookie (HMAC-SHA256 over adminId.exp).
# REQUIRED in production: generate with `openssl rand -hex 32`. Falls back to
# an insecure dev-only constant when unset (a console warning is printed).
AUTH_SECRET=""

# Staff account for `bun run db:seed` — creates or updates the single
# staff login used to sign in at /login and manage appointments in
# /dashboard. Use strong values outside local development. Never commit real
# secrets: the entries below are placeholders, the real values live in your
# git-ignored .env.
# GOTCHA: values starting with `$` must be escaped (`\$`) — dotenv treats a
# bare `$` as variable-interpolation syntax and silently resolves it to "".
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
